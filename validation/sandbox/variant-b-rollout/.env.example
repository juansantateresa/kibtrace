# Postgres
POSTGRES_DB=detections
POSTGRES_USER=kibtrace
POSTGRES_PASSWORD=kibtrace

# Service configuration
SERVICE_ENVIRONMENT=staging
DEPLOYMENT_VERSION=deploy-2026-04-12-rollout-b
CAMERA_ID=camera-east-loading-bay
MODEL_VERSION=yolo11n-2026.04

# Rollout skew: 30% of persistence requests go to v2 (the broken version)
V2_ROUTE_PERCENT=30

# Frame generation
FRAME_INTERVAL_MS=200
TOTAL_FRAMES=500

# External Elasticsearch (start-local authenticated instance).
ELASTICSEARCH_HOST=http://host.docker.internal:9200

# Filebeat needs the API key in id:key format (decoded).
# To get it: echo '<ES_LOCAL_API_KEY from elastic-start-local/.env>' | base64 -d
# kibtrace fetch uses the base64-encoded form directly (via KIBTRACE_ES_API_KEY env var).
ELASTICSEARCH_API_KEY=replace-me-with-decoded-id:key
ELASTICSEARCH_INDEX_PREFIX=kibtrace-auth-variant-b

# Filebeat image version
FILEBEAT_STACK_VERSION=9.3.3
