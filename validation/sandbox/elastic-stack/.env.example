# Match versions across the Elastic stack.
STACK_VERSION=9.3.1

# Bind ports to localhost only for local development.
ES_PORT=127.0.0.1:9200
KIBANA_PORT=127.0.0.1:5601
POSTGRES_PORT=127.0.0.1:5432

# Fake app configuration.
APP_SERVICE_NAME=cv-db-failure-app
APP_SERVICE_VERSION=0.1.0-sandbox
APP_CAMERA_ID=camera-east-loading-bay
APP_MODEL_VERSION=yolo11n-2026.04
APP_DEPLOYMENT_VERSION=deploy-2026-04-09-a
APP_FRAME_INTERVAL_MS=750
APP_INCIDENT_MODE=wrong_table
APP_LOG_LEVEL=info

# Postgres configuration.
POSTGRES_DB=detections
POSTGRES_USER=kibtrace
POSTGRES_PASSWORD=kibtrace

# Kibana encryption keys for local sandbox stability.
KIBANA_ENCRYPTED_SAVED_OBJECTS_KEY=kibtrace-sandbox-encrypted-saved-objects-key-2026
KIBANA_SECURITY_ENCRYPTION_KEY=kibtrace-sandbox-security-encryption-key-2026
KIBANA_REPORTING_ENCRYPTION_KEY=kibtrace-sandbox-reporting-encryption-key-2026
