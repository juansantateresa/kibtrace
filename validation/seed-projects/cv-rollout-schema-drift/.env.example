# Postgres
POSTGRES_DB=detections
POSTGRES_USER=kibtrace
POSTGRES_PASSWORD=kibtrace

# Service versions
FRAME_INGESTOR_VERSION=1.0.0
DETECTOR_WORKER_VERSION=1.0.0
PERSISTOR_V1_VERSION=v1
PERSISTOR_V2_VERSION=v2

# Routing: percentage of requests sent to v2 (0-100)
V2_ROUTE_PERCENT=30

# Timing
FRAME_INTERVAL_MS=200
TOTAL_FRAMES=500

# Camera / model metadata
CAMERA_ID=camera-east-loading-bay
MODEL_VERSION=yolo11n-2026.04
DEPLOYMENT_VERSION=deploy-2026-04-12-rollout-b

# Service environment
SERVICE_ENVIRONMENT=staging
